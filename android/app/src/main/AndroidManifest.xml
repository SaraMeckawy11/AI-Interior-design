<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.VIBRATE"/>

  <!--
    Google Play's photo and video permissions policy: an app targeting API 33+
    may only request READ_MEDIA_IMAGES / READ_MEDIA_VIDEO when the system
    pickers cannot provide core functionality. Livinai's do, so these are
    removed. Version codes 42, 49 and 78 shipped them and were flagged.

    They are not declared here — they merge in from expo-media-library's own
    manifest, which unconditionally declares all four READ_MEDIA_* permissions.
    Deleting a line from this file therefore does nothing; the permissions have
    to be stripped at merge time, which is what tools:node="remove" does.

    Nothing asks for them at runtime, so removing them costs no functionality:

      - Choosing a photo goes through expo-image-picker, whose
        getMediaLibraryPermissions() returns an empty array on API 33+ because
        launchImageLibraryAsync uses the Android photo picker.
      - Saving a render calls MediaLibrary.saveToLibraryAsync behind
        requestPermissionsAsync(true) — writeOnly — and expo-media-library only
        ever adds READ_MEDIA_* when writeOnly is false. On API 33+ its
        hasWritePermissions() short-circuits to false, so a save needs no
        permission at all.

    READ_EXTERNAL_STORAGE and WRITE_EXTERNAL_STORAGE stay. Google did not flag
    them, and on API 32 and below both modules still require them to pick and
    to save; removing them would break Android 7 through 12.
  -->
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove"/>

  <!-- Android has no Apple ATT prompt. Google UMP resolves consent before the
       ad SDK starts, and this normal permission lets AdMob use Android's
       resettable Advertising ID only where the user and regional rules allow. -->
  <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>

  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>

  <!--
    `enableOnBackInvokedCallback="false"` is what keeps the back gesture inside
    the app.

    At targetSdk 36 Android 16 turns predictive back on by default, and it then
    stops calling `Activity.onBackPressed` and stops dispatching KEYCODE_BACK.
    React Native 0.79 still routes the hardware back press through exactly those
    two, so with predictive back on, JavaScript never hears about the gesture at
    all: React Navigation cannot pop, `BackHandler` listeners never fire, and the
    system does the only thing left to it and closes the activity. Every back
    swipe left the app instead of moving one screen back inside it.

    Opting out restores the legacy dispatch, which is still supported on Android
    16 (`OnBackPressedCallback` keeps working; only the platform's
    `OnBackInvokedCallback` is ignored). The cost is the predictive back preview
    animation, which the app never had.

    This is a stopgap tied to the React Native version, not a preference: RN 0.81
    handles the new callback, so drop this line on that upgrade. AdMob's own
    AdActivity already ships the same opt-out, so nothing regresses there.
  -->
  <application
    android:name=".MainApplication"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:allowBackup="true"
    android:theme="@style/AppTheme"
    android:supportsRtl="true"
    android:requestLegacyExternalStorage="true"
    android:fullBackupContent="@xml/secure_store_backup_rules"
    android:dataExtractionRules="@xml/secure_store_data_extraction_rules"
    android:enableOnBackInvokedCallback="false">

    <!--
      At targetSdk 36 Android ignores android:screenOrientation on displays of
      sw600dp and up, so the portrait lock below stops holding on tablets and
      unfolded foldables. The screens are laid out for a phone, so opt out for
      now. This is a stopgap with a shelf life: the framework drops the opt-out
      at targetSdk 37, and the layouts have to handle landscape by then.
    -->
    <property
        android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
        android:value="true"/>

    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>

    <!-- ✅ Updated to fix manifest merge conflict -->
    <meta-data
        android:name="com.google.android.gms.ads.APPLICATION_ID"
        android:value="ca-app-pub-4470538534931449~7850095110"
        tools:replace="android:value"/>
    <meta-data
        android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
        android:value="true"
        tools:replace="android:value"/>

    <activity
        android:name=".MainActivity"
        android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|locale|layoutDirection"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.App.SplashScreen"
        android:exported="true"
        android:screenOrientation="portrait">

        <intent-filter>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent-filter>

        <intent-filter>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.DEFAULT"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="livinai"/>
            <data android:scheme="exp+livinai"/>
        </intent-filter>
    </activity>
</application>

</manifest>
