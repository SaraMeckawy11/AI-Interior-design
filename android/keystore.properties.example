# Upload-key credentials for local release and sign-in-capable debug builds.
#
# Copy this file to android/keystore.properties and fill in the real values.
# That copy is gitignored and must stay that way — anything committed here is
# public from the moment it is pushed, and stays public in the history even if
# the line is later deleted.
#
# CI supplies the same names as environment variables instead of this file.

# Path to the .jks, relative to the android/ directory.
LIVINAI_UPLOAD_STORE_FILE=../credentials/android/keystore.jks

LIVINAI_UPLOAD_STORE_PASSWORD=
LIVINAI_UPLOAD_KEY_ALIAS=

# Optional — defaults to LIVINAI_UPLOAD_STORE_PASSWORD when the key and the
# store share a password, which is what `keytool` does unless told otherwise.
LIVINAI_UPLOAD_KEY_PASSWORD=
