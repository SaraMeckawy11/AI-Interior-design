# Copy to .env and fill in real values.
# The API_KEY is used by the backend to authenticate to the Modal endpoint.
# It is uploaded to Modal as a secret (see README step 3), NOT baked into the image.

API_KEY=replace-with-a-long-random-string

# Gated Hugging Face repo for black-forest-labs/FLUX.2-klein-4B.
# Uploaded to Modal as the `livinai-hf-token` secret; deploy fails without it.
HF_TOKEN=replace-with-a-huggingface-read-token

# Prefer the router endpoint: it dispatches on a cheap CPU container instead of
# waking a GPU class just to decide which engine to use.
MODAL_ENDPOINT_URL=https://sara123meckawy--livinai-interior-generate.modal.run
